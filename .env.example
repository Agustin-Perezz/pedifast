# Sentry
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Supabase (required — app crashes if missing, no defaults)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (required — app crashes if missing, no defaults)
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_OAUTH_STATE_SECRET=

# Google Maps (required — app crashes if missing, no defaults)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=
